# Copy to .env.local (git-ignored) to turn on WhatsApp alerts. Leave empty and the app
# works exactly as before, fully offline. Setup: docs/WHATSAPP_ALERTS.md

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bol-ke-hisaab-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bol-ke-hisaab-2026
VITE_FIREBASE_APP_ID=

# The WhatsApp Business number that sends alerts, country code + digits, e.g. 919800000000
VITE_WHATSAPP_BUSINESS_NUMBER=
