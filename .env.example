# Copy to .env.local (git-ignored) to turn on Telegram alerts. Leave empty and the app
# works exactly as before, fully offline. Setup: docs/TELEGRAM_ALERTS.md

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bol-ke-hisaab-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bol-ke-hisaab-2026
VITE_FIREBASE_APP_ID=

# Your alert bot's username from @BotFather, without the @
VITE_TELEGRAM_BOT_USERNAME=
